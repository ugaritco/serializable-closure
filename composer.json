{
    "name": "ugarit/serializable-closure",
    "description": "Ugarit Serializable Closure provides an easy and secure way to serialize closures in PHP.",
    "keywords": [
        "ugarit",
        "Serializable",
        "closure"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/serializable-closure/issues",
        "source": "https://github.com/ugarit/serializable-closure"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        },
        {
            "name": "Nuno Maduro",
            "email": "nuno@ugarit.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "heritage/support": "^1.00.00",
        "nesbot/carbon": "^2.67|^3.0",
        "pestphp/pest": "^2.36|^3.0|^4.0",
        "phpstan/phpstan": "^2.0",
        "symfony/var-dumper": "^6.2.0|^7.0.0|^8.0.0"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\SerializableClosure\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
